{
  "name": "print-upscaler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first AI image upscaler for very large format printing",
  "scripts": {
    "models": "node scripts/fetch-models.mjs",
    "dev": "npm run models && vite",
    "build": "npm run models && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "npm run test:logic && npm run test:browser && npm run test:app",
    "test:logic": "tsx --test tests/logic.test.mts",
    "test:browser": "node tests/run-browser.mjs",
    "test:app": "node tests/run-app.mjs",
    "test:encoders": "node tests/build-encoder-fixtures.mjs && python3 tests/verify-encoders.py tests/tmp/encoders",
    "bench:encoders": "tsx tests/encoder-timing.mts"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "fflate": "0.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@upscalerjs/esrgan-medium": "1.0.0",
    "@upscalerjs/esrgan-slim": "1.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.54.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
