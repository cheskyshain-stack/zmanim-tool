{
  "name": "shul-tv-display",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  // Keep the Access settings and domain routes managed in Cloudflare.
  "keep_vars": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shul-display",
      "database_id": "28241f85-25ca-4755-8b63-60dddbe1a935",
      "migrations_dir": "migrations"
    }
  ],
  "minify": true
}
