{
  "name": "shul-tv-display-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "LOCAL_DEVELOPMENT": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shul-display",
      "database_id": "local-display",
      "migrations_dir": "migrations"
    }
  ]
}
