{
  "name": "Lakewood Commons Calendar",
  "short_name": "LC Calendar",
  "description": "The private community calendar and announcements for Bais Medrash of Lakewood Commons. Sign in with your calendar account.",
  "id": "/admin/calendar/",
  "start_url": "/admin/calendar/",
  "scope": "/admin/calendar/",
  "display_override": ["standalone"],
  "display": "browser",
  "background_color": "#faf7f0",
  "theme_color": "#142b46",
  "lang": "en",
  "icons": [
    { "src": "/icons/calendar/icon-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/calendar/icon-512.png?v=1", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/calendar/icon-maskable-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/calendar/icon-maskable-512.png?v=1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
