{
  "name": "Shul Messages",
  "short_name": "Messages",
  "description": "Private messages and phone alerts from Bais Medrash of Lakewood Commons. Use your existing shul account.",
  "id": "/admin/calendar/",
  "start_url": "/messages/",
  "scope": "/messages/",
  "display_override": [
    "standalone"
  ],
  "display": "standalone",
  "background_color": "#faf7f0",
  "theme_color": "#142b46",
  "lang": "en",
  "icons": [
    {
      "src": "/icons/calendar/icon-192.png?v=1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/calendar/icon-512.png?v=1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/calendar/icon-maskable-192.png?v=1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/calendar/icon-maskable-512.png?v=1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
